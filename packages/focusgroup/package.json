{
  "name": "@microsoft/focusgroup-polyfill",
  "version": "1.2.1",
  "description": "A polyfill for the focusgroup HTML attribute.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:lib:min && npm run build:lib:shadowless && npm run build:lib:shadowless-min && npm run build:types",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:lib:min": "npm run build:lib -- --mode minified",
    "build:lib:shadowless": "npm run build:lib -- --mode shadowless",
    "build:lib:shadowless-min": "npm run build:lib -- --mode shadowless-minified",
    "build:types": "tsc",
    "test": "playwright test",
    "test:ci": "npm test -- --project=chromium --project=firefox --project=webkit",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/polyfills.git",
    "directory": "packages/focusgroup"
  },
  "keywords": [
    "focusgroup",
    "polyfill",
    "edge",
    "html"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "./build/index.mjs",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index.mjs"
    },
    "./minified": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index.min.mjs"
    },
    "./unminified": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index.mjs"
    },
    "./shadowless": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index-shadowless.mjs"
    },
    "./shadowless-minified": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index-shadowless.min.mjs"
    },
    "./shadowless-unminified": {
      "types": "./build/types/index.d.ts",
      "default": "./build/index-shadowless.mjs"
    }
  },
  "files": [
    "build"
  ],
  "size-limit": [
    {
      "path": "build/index.min.mjs",
      "limit": "6 kB",
      "gzip": true
    },
    {
      "path": "build/index.min.mjs",
      "limit": "5 kB"
    },
    {
      "path": "build/index-shadowless.min.mjs",
      "limit": "4 kB",
      "gzip": true
    },
    {
      "path": "build/index-shadowless.min.mjs",
      "limit": "4 kB"
    }
  ],
  "bugs": {
    "url": "https://github.com/Microsoft/polyfills/issues"
  },
  "homepage": "https://github.com/microsoft/polyfills/tree/main/packages/focusgroup#readme",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "^25.6.0",
    "size-limit": "12.1.0",
    "terser": "5.46.2",
    "typescript": "^6.0.3",
    "vite": "8.0.10"
  }
}
