{
  "name": "@microsoft/focusgroup-polyfill",
  "version": "1.2.1",
  "description": "A polyfill for the focusgroup HTML attribute.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:lib:min && npm run build:lib:shadowless && npm run build:lib:shadowless-min",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:lib:min": "npm run build:lib -- --mode minified",
    "build:lib:shadowless": "npm run build:lib -- --mode shadowless",
    "build:lib:shadowless-min": "npm run build:lib -- --mode shadowless-minified",
    "test": "playwright test",
    "test:ci": "npm test -- --project=chromium --project=firefox --project=webkit",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/polyfills.git",
    "directory": "packages/focusgroup"
  },
  "keywords": [
    "focusgroup",
    "polyfill",
    "edge",
    "html"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "type": "module",
  "module": "./build/focusgroup-polyfill.min.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/focusgroup-polyfill.min.mjs"
    },
    "./unminified": {
      "types": "./build/index.d.ts",
      "default": "./build/focusgroup-polyfill.mjs"
    },
    "./shadowless": {
      "types": "./build/index.d.ts",
      "default": "./build/focusgroup-polyfill-shadowless.min.mjs"
    },
    "./shadowless-unminified": {
      "types": "./build/index.d.ts",
      "default": "./build/focusgroup-polyfill-shadowless.mjs"
    }
  },
  "files": [
    "build"
  ],
  "size-limit": [
    {
      "path": "build/focusgroup-polyfill.min.mjs",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "path": "build/focusgroup-polyfill.min.mjs",
      "limit": "10 kB"
    }
  ],
  "bugs": {
    "url": "https://github.com/Microsoft/polyfills/issues"
  },
  "homepage": "https://github.com/microsoft/polyfills/tree/main/packages/focusgroup#readme",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@size-limit/preset-small-lib": "12.0.1",
    "@types/node": "^25.4.0",
    "size-limit": "12.0.1",
    "terser": "5.46.1",
    "vite": "8.0.3"
  }
}
