{
  "name": "@microsoft/focusgroup-polyfill",
  "version": "0.0.1",
  "description": "A polyfill for the focusgroup HTML attribute.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:lib:min && npm run build:lib:shadowless && npm run build:lib:shadowless-min",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:lib:min": "npm run build:lib -- --mode minified",
    "build:lib:shadowless": "npm run build:lib -- --mode shadowless",
    "build:lib:shadowless-min": "npm run build:lib -- --mode shadowless-minified",
    "test": "playwright test",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicrosoftEdge/focusgroup-polyfill.git"
  },
  "keywords": [
    "focusgroup",
    "polyfill",
    "edge",
    "html"
  ],
  "author": "MicrosoftEdge",
  "license": "MIT",
  "type": "module",
  "module": "./build/focusgroup-polyfill.min.mjs",
  "exports": {
    ".": {
      "import": "./build/focusgroup-polyfill.min.mjs"
    },
    "./unminified": {
      "import": "./build/focusgroup-polyfill.mjs"
    },
    "./shadowless": {
      "import": "./build/focusgroup-polyfill-shadowless.min.mjs"
    },
    "./shadowless-unminified": {
      "import": "./build/focusgroup-polyfill-shadowless.mjs"
    }
  },
  "files": [
    "build"
  ],
  "size-limit": [
    {
      "path": "build/focusgroup-polyfill.min.mjs",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "path": "build/focusgroup-polyfill.min.mjs",
      "limit": "10 kB"
    }
  ],
  "bugs": {
    "url": "https://github.com/MicrosoftEdge/focusgroup-polyfill/issues"
  },
  "homepage": "https://github.com/MicrosoftEdge/focusgroup-polyfill#readme",
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@size-limit/preset-small-lib": "12.0.0",
    "@types/node": "^25.4.0",
    "size-limit": "12.0.0",
    "terser": "5.46.0",
    "vite": "7.3.1"
  }
}
