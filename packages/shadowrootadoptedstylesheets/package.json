{
  "name": "@microsoft/shadowrootadoptedstylesheets-ponyfill",
  "version": "0.0.1",
  "private": true,
  "description": "A pony fill for `shadowrootadoptedstylesheets` attribute on Declarative Shadow DOM.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:lib:min",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:lib:min": "npm run build:lib -- --mode minified",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.mjs"
    },
    "./minified": {
      "types": "./build/index.d.ts",
      "default": "./build/index.min.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/polyfills.git",
    "directory": "packages/shadowrootadoptedstylesheets"
  },
  "keywords": [
    "html",
    "adopted style sheets",
    "web components",
    "custom elements",
    "shadow dom",
    "declarative shadow dom",
    "css module",
    "declarative css module",
    "ponyfill",
    "polyfill"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/microsoft/polyfills/tree/main/packages/shadowrootadoptedstylesheets#readme"
}
