{
  "name": "polyfills",
  "version": "1.0.0",
  "description": "A collection of polyfills for new and upcoming web platform features.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:ci --workspaces --if-present",
    "check": "biome check",
    "fix": "biome check --fix",
    "change": "beachball change --dependent-change-type none",
    "checkchange": "beachball check --changehint \"Run 'npm run change' to generate a change file\"",
    "publish": "beachball publish",
    "publish-ci": "beachball publish -y --no-publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/polyfills.git"
  },
  "keywords": [
    "html",
    "polyfill"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/polyfills/issues"
  },
  "homepage": "https://github.com/microsoft/polyfills#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "beachball": "2.64.0",
    "lefthook": "2.1.1"
  }
}
