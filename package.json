{
  "name": "polyfills",
  "version": "1.0.0",
  "description": "A collection of polyfills for new and upcoming web platform features.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lage build",
    "test": "lage test:ci",
    "check": "biome check",
    "fix": "biome check --fix",
    "change": "beachball change --dependent-change-type none",
    "bump": "beachball bump",
    "checkchange": "node build/scripts/check-publish-pipeline.mjs && node build/scripts/checkchange.mjs",
    "test:scripts": "node --test build/scripts/*.test.mjs",
    "prepare-release-artifacts": "node build/scripts/prepare-release-artifacts.mjs",
    "publish": "beachball publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/polyfills.git"
  },
  "keywords": [
    "html",
    "polyfill"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/polyfills/issues"
  },
  "homepage": "https://github.com/microsoft/polyfills#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "1.61.0",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "^25.6.0",
    "beachball": "2.65.3",
    "lage": "2.15.11",
    "lefthook": "2.1.6",
    "size-limit": "12.1.0",
    "terser": "5.46.2",
    "vite": "8.0.16"
  }
}
